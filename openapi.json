{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "An explanation of why the request could not be completed.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "IdentityResponse": {
        "description": "The currently signed-in account.",
        "properties": {
          "is_owner": {
            "title": "Is Owner",
            "type": "boolean"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "username",
          "is_owner"
        ],
        "title": "IdentityResponse",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "Whether the service is running.",
        "properties": {
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Username and password for a local account.",
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "description": "Signed-in account details and sign-in expiry.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "is_owner": {
            "title": "Is Owner",
            "type": "boolean"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "username",
          "is_owner",
          "expires_at"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "LoginStartRequest": {
        "additionalProperties": false,
        "description": "The page to open after signing in.",
        "properties": {
          "return_to": {
            "default": "/",
            "maxLength": 256,
            "title": "Return To",
            "type": "string"
          }
        },
        "title": "LoginStartRequest",
        "type": "object"
      },
      "LoginStartResponse": {
        "description": "A link to open to sign in.",
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          }
        },
        "required": [
          "authorization_url"
        ],
        "title": "LoginStartResponse",
        "type": "object"
      },
      "LogoutResponse": {
        "description": "Whether this browser has been signed out.",
        "properties": {
          "logged_out": {
            "default": true,
            "title": "Logged Out",
            "type": "boolean"
          }
        },
        "title": "LogoutResponse",
        "type": "object"
      },
      "PlatformInfoResponse": {
        "description": "Service name and installed version.",
        "properties": {
          "service": {
            "const": "TinyPods",
            "default": "TinyPods",
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "PlatformInfoResponse",
        "type": "object"
      },
      "ProviderDescriptor": {
        "description": "A sign-in method available for this installation.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "login_path": {
            "title": "Login Path",
            "type": "string"
          },
          "logout_path": {
            "default": "/auth/logout",
            "title": "Logout Path",
            "type": "string"
          },
          "type": {
            "enum": [
              "password",
              "redirect"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "login_path"
        ],
        "title": "ProviderDescriptor",
        "type": "object"
      },
      "ProviderLogoutResponse": {
        "description": "Sign-out result and an optional link to finish external sign-out.",
        "properties": {
          "logged_out": {
            "default": true,
            "title": "Logged Out",
            "type": "boolean"
          },
          "logout_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logout Url"
          }
        },
        "required": [
          "logout_url"
        ],
        "title": "ProviderLogoutResponse",
        "type": "object"
      },
      "ProvidersResponse": {
        "description": "Available sign-in methods.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ProviderDescriptor"
            },
            "title": "Data",
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "title": "ProvidersResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Whether the service and its required connections are ready.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "A field that needs to be corrected.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          }
        },
        "required": [
          "location",
          "code"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TinyPods API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Sign in with a local username and password.\n\nReturns your account details and signs this browser in. Provide the sign-in header\nshown in the request parameters.",
        "operationId": "authLocalLogin",
        "parameters": [
          {
            "description": "Set this header to login when starting sign-in.",
            "example": "login",
            "in": "header",
            "name": "x-csrf-token",
            "required": true,
            "schema": {
              "const": "login",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "local": {
                  "summary": "Local account login",
                  "value": {
                    "password": "<your-password-at-least-15-characters>",
                    "username": "owner"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Signed in. Browser sign-in details have been updated."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "The username or password was not accepted."
          },
          "403": {
            "description": "This sign-in request could not be verified."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "description": "Too many sign-in attempts. Wait before trying again.",
            "headers": {
              "Retry-After": {
                "description": "How long to wait, in seconds.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Sign-in is temporarily unavailable. Try again later."
          }
        },
        "summary": "Sign in with a local account",
        "tags": [
          "Authentication"
        ],
        "x-tinypods-rate-limit": {
          "limit": 10,
          "name": "login",
          "window_ms": 60000
        }
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Sign this browser out of TinyPods.\n\nOther browsers stay signed in. Signing out here does not sign you out of an\nexternal identity provider.",
        "operationId": "authSessionLogout",
        "parameters": [
          {
            "description": "Copy the current CSRF cookie value into this header.",
            "in": "header",
            "name": "x-csrf-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            },
            "description": "This browser is signed out of TinyPods."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Sign in before using this action."
          },
          "403": {
            "description": "This sign-out request could not be verified."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Sign out of TinyPods",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/providers": {
      "get": {
        "description": "Show the sign-in methods available for this installation.\n\nUse this list to display a local account form or an external sign-in button.",
        "operationId": "authProvidersList",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "List available sign-in methods",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/providers/zitadel/callback": {
      "get": {
        "description": "Complete sign-in after returning from Zitadel.\n\nSigns this browser in and sends you to the page chosen when sign-in started.\nThe sign-in attempt must still be valid.",
        "operationId": "authZitadelLoginCallback",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 4096,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          },
          {
            "in": "query",
            "name": "iss",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 2048,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Iss"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Signed in. Continue to the requested page.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Complete Zitadel sign-in",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/providers/zitadel/logout": {
      "post": {
        "description": "Sign this browser out of TinyPods and get a link to sign out of Zitadel.\n\nOpen the returned link to finish signing out of Zitadel. This can also sign you\nout of other applications using Zitadel in the same browser.",
        "operationId": "authZitadelLogout",
        "parameters": [
          {
            "description": "Copy the current CSRF cookie value into this header.",
            "in": "header",
            "name": "x-csrf-token",
            "required": true,
            "schema": {
