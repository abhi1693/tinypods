                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Logout Zitadel",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/providers/zitadel/start": {
      "post": {
        "description": "Start Code+PKCE S256 login after a same-origin custom-header CSRF check.\n\nStore state/nonce/verifier server-side for five minutes. Only an opaque Secure,\nHttpOnly, SameSite=Lax correlation cookie crosses the top-level callback navigation.\nThe application session cookie remains Strict. Reject unsafe return targets (400),\ndisabled providers (404), rate limits (429) and unavailable dependencies (503).",
        "operationId": "startZitadelLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginStartRequest"
