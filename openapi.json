{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "Carry a public error code, message, correlation ID and optional validation issues.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "IdentityResponse": {
        "description": "Expose only the authenticated account's normalized identity.",
        "properties": {
          "is_owner": {
            "title": "Is Owner",
            "type": "boolean"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "username",
          "is_owner"
        ],
        "title": "IdentityResponse",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "Report process liveness independently of dependency availability.",
        "properties": {
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Accept bounded local credentials; passwords stay masked in diagnostics.",
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "description": "Report absolute session expiration; the bearer token is in an HttpOnly cookie.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "is_owner": {
            "title": "Is Owner",
            "type": "boolean"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "username",
          "is_owner",
          "expires_at"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "LoginStartRequest": {
        "additionalProperties": false,
        "description": "Accept only a bounded local post-login path.",
        "properties": {
          "return_to": {
            "default": "/",
            "maxLength": 256,
            "title": "Return To",
            "type": "string"
          }
        },
        "title": "LoginStartRequest",
        "type": "object"
      },
      "LoginStartResponse": {
        "description": "Carry one fresh authorization challenge; transaction secrets remain server-side.",
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          }
        },
        "required": [
          "authorization_url"
        ],
        "title": "LoginStartResponse",
        "type": "object"
      },
      "LogoutResponse": {
        "description": "Confirm durable session revocation.",
        "properties": {
          "logged_out": {
            "default": true,
            "title": "Logged Out",
            "type": "boolean"
          }
        },
        "title": "LogoutResponse",
        "type": "object"
      },
      "PlatformInfoResponse": {
        "description": "Expose public platform identity without process configuration or credentials.\n\nAttributes:\n    service: Static service display name.\n    version: Version of the installed TinyPods core distribution.",
        "properties": {
          "service": {
            "const": "TinyPods",
            "default": "TinyPods",
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "PlatformInfoResponse",
        "type": "object"
      },
      "ProviderDescriptor": {
        "description": "Expose only enabled login methods and same-origin actions, never provider secrets/config.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "login_path": {
            "title": "Login Path",
            "type": "string"
          },
          "logout_path": {
            "default": "/auth/logout",
            "title": "Logout Path",
            "type": "string"
          },
          "type": {
            "enum": [
              "password",
              "redirect"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "login_path"
        ],
        "title": "ProviderDescriptor",
        "type": "object"
      },
      "ProviderLogoutResponse": {
        "description": "Confirm application revocation and expose an optional token-free upstream logout target.",
        "properties": {
          "logged_out": {
            "default": true,
            "title": "Logged Out",
            "type": "boolean"
          },
          "logout_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logout Url"
          }
        },
        "required": [
          "logout_url"
        ],
        "title": "ProviderLogoutResponse",
        "type": "object"
      },
      "ProvidersResponse": {
        "description": "List configured enabled methods without contacting an upstream identity provider.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ProviderDescriptor"
            },
            "title": "Data",
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "title": "ProvidersResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Report aggregate readiness and the individual boolean dependency outcomes.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "Expose a rejected input location and code without echoing its value.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          }
        },
        "required": [
          "location",
          "code"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TinyPods API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Sign in with local credentials and issue Secure, SameSite=Strict host-only cookies.\n\nSend X-CSRF-Token: login and JSON credentials from the API's origin. HTTP 401\nrejects invalid credentials; 429 limits attempts with Retry-After; 503 fails\nclosed when storage is unavailable. The session cookie is HttpOnly. Read the\nseparate CSRF cookie and send it in X-CSRF-Token on subsequent mutations.",
        "operationId": "loginLocal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Login",
        "tags": [
          "Authentication"
        ],
        "x-tinypods-rate-limit": {
          "limit": 10,
          "name": "login",
          "window_ms": 60000
        }
      }
    },
    "/auth/logout": {
      "post": {
