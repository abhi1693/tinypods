{
  "name": "tinypods",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/http",
    "packages/ui",
    "packages/theme",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "npm run dev --workspace @tinypods/web",
    "build": "npm run build --workspace @tinypods/web",
    "start": "npm run start --workspace @tinypods/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api:generate": "orval --config apps/web/orval.config.ts",
    "api:check": "node scripts/check-generated-api.mjs",
    "test:contracts": "node --test scripts/frontend-contract.test.mjs",
    "check": "npm run api:check && npm run test:contracts && npm run test:auth && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth": "node --test scripts/frontend-auth-msw.test.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "msw": "2.15.0",
    "orval": "8.46.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
