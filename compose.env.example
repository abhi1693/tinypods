# Copy to .env. Use different random hex passwords for the two services.
# Generate each password with: python -c "import secrets; print(secrets.token_hex(32))"
COMPOSE_PROFILES=local
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
TINYPODS_DATABASE_URL=postgresql+psycopg://tinypods:${POSTGRES_PASSWORD}@postgres:5432/tinypods
TINYPODS_VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0
TINYPODS_DATABASE_MODE=direct
# Set a direct URL when the runtime database URL points at PgBouncer.
# TINYPODS_MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@postgres-host:5432/tinypods
TINYPODS_PUBLISH_HOST=0.0.0.0
TINYPODS_PUBLISH_PORT=8000
TINYPODS_WORKER_REPLICAS=1
TINYPODS_WORKER_CPUS=0.5
TINYPODS_WORKER_MEMORY=256m
# For external services, clear COMPOSE_PROFILES and replace both service URLs.
# TINYPODS_BACKEND_IMAGE can select an existing multi-architecture backend image.

# Optional pull-through registry, e.g. registry.home; omit scheme and trailing slash.
# Mirrored paths follow DevFeed: <registry>/docker.io/... and <registry>/ghcr.io/...
TINYPODS_IMAGE_REGISTRY=
