# Application mode: production requires HTTPS; development allows HTTP browser redirects.
TINYPODS_ENVIRONMENT=production
TINYPODS_API_HOST=0.0.0.0
TINYPODS_API_PORT=8000
TINYPODS_LOG_LEVEL=INFO
TINYPODS_READINESS_TIMEOUT=2

# Optional until database-backed features are needed. Export environment values explicitly.
# TINYPODS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tinypods
TINYPODS_DATABASE_MODE=direct
TINYPODS_DATABASE_POOL_SIZE=5
TINYPODS_DATABASE_MAX_OVERFLOW=5
TINYPODS_DATABASE_POOL_TIMEOUT=5
TINYPODS_DATABASE_CONNECT_TIMEOUT=5
# For PgBouncer transaction pooling, set MODE=pgbouncer and DATABASE_URL to its endpoint.
# A direct URL is required for migrations in that mode; credentials may be the same.
# TINYPODS_MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/tinypods

TINYPODS_LOG_FORMAT=text

# Shared Valkey rate limits; blank URL falls back to TINYPODS_VALKEY_URL.
TINYPODS_RATE_LIMIT_VALKEY_URL=
TINYPODS_RATE_LIMIT_NAMESPACE=tinypods:limits
# Optional aggregate HTTP requests/minute; 0 leaves endpoint/auth limits active.
TINYPODS_RATE_LIMIT_GLOBAL_PER_MINUTE=0

# Built-in supported providers. Explicitly disable local login for external-only deployments.
TINYPODS_AUTH_LOCAL_ENABLED=true
TINYPODS_ZITADEL_ENABLED=false
# Configure only when enabling Zitadel (HTTPS endpoints, exact registered callback).
# TINYPODS_ZITADEL_ISSUER=https://identity.example.org
# TINYPODS_ZITADEL_CLIENT_ID=your-web-pkce-client
# Optional organization selection; omit the IdP ID to use Zitadel's own login page.
# TINYPODS_ZITADEL_ORGANIZATION_ID=your-organization-id
# TINYPODS_ZITADEL_IDENTITY_PROVIDER_ID=your-optional-upstream-idp-id
# TINYPODS_ZITADEL_REDIRECT_URI=https://tinypods.example.org/auth/providers/zitadel/callback
# TINYPODS_ZITADEL_POST_LOGOUT_URI=https://tinypods.example.org/
# Explicit subject admission; empty denies all external accounts, including previously linked ones.
TINYPODS_ZITADEL_ALLOWED_SUBJECTS=[]
# Supported baseline: Web + PKCE (S256), token endpoint authentication none.
TINYPODS_ZITADEL_TOKEN_AUTH_METHOD=none
# Confidential client support requires matching Zitadel application settings.
# TINYPODS_ZITADEL_CLIENT_SECRET=load-from-your-secret-manager
